rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype-only signaling channel. No consultation notes, patient records,
    // audio, or video are stored here.
    //
    // This remains intentionally unauthenticated for the hackathon milestone.
    // Replace it with authenticated participant rules before using real data.
    match /teleconsult_calls/{appointmentId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /patientCandidates/{candidateId} {
        allow read, create: if true;
        allow update, delete: if false;
      }

      match /doctorCandidates/{candidateId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }
  }
}
